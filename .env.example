# =============================================================================
# ESCRO Platform — docker-compose environment template
# Copy to .env.local (dev) or .env.prod (prod) and fill in real values.
# Load with:  docker compose --env-file .env.local up -d --build
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# --- Host-side port mapping -------------------------------------------------
# Change these if the host already uses these ports.
FRONTEND_PORT_HOST=3000
BACKEND_PORT_HOST=5000
DB_PORT_HOST=5432

# --- PostgreSQL -------------------------------------------------------------
# Inside the compose network, backend talks to host "postgres" on port 5432.
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=escro_platform

# --- JWT --------------------------------------------------------------------
# Generate with:  openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Email (SMTP) -----------------------------------------------------------
# Leave EMAIL_USER / EMAIL_PASS empty to log emails instead of sending.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=ESCRO Platform

# --- App URLs / admin -------------------------------------------------------
ADMIN_EMAIL=vladau.claudiu95@gmail.com
FRONTEND_URL=http://localhost:3000

# --- Uploads ----------------------------------------------------------------
MAX_FILE_SIZE=10485760

# --- Sentry (optional) ------------------------------------------------------
# BACKEND_SENTRY_DSN is read at runtime by the backend.
# FRONTEND_SENTRY_DSN is bundled at build time into the React app.
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
