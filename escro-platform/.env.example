# Root .env — read by docker-compose (escro-platform/.env on VPS).
# Holds DB credentials that compose passes to the postgres container.
# IMPORTANT: DB_USER / DB_PASSWORD / DB_NAME must MATCH backend/.env exactly.

DB_NAME=escro_platform
DB_USER=escro
DB_PASSWORD=REPLACE_WITH_SAME_VALUE_AS_BACKEND_DB_PASSWORD

# Optional Sentry build args for frontend image (leave empty to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
