# ESCRO Platform Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=escro_platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (SMTP) — required for notification emails
# Gmail setup:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Put the 16-char password (no spaces) in EMAIL_PASS below
#   4. EMAIL_FROM must equal EMAIL_USER for Gmail (it rewrites the From: header)
# If EMAIL_USER or EMAIL_PASS is empty, emails are logged instead of sent.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=ESCRO Platform

# Admin Email
ADMIN_EMAIL=vladau.claudiu95@gmail.com

# Frontend URL
FRONTEND_URL=http://localhost:3000
