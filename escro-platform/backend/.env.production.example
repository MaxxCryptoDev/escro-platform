# PRODUCTION env for backend container (escro-platform/backend/.env)
# Copy to .env on the VPS and fill values. DO NOT commit the real .env.
#
# Generate secrets locally with:
#   openssl rand -hex 32   # DB_PASSWORD
#   openssl rand -hex 64   # JWT_SECRET

NODE_ENV=production
PORT=5000

# --- Database (DB_HOST=db is the service name in docker-compose) ---
DB_HOST=db
DB_PORT=5432
DB_USER=escro
DB_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
DB_NAME=escro_platform

# --- Auth ---
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_64
JWT_EXPIRE=7d

# --- Stripe (test mode at launch; switch to live after KYC) ---
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_AFTER_CREATING_WEBHOOK

# --- Email (Gmail SMTP) ---
# 1. Enable 2FA on Google account
# 2. Generate app password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-char password (no spaces) below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=vladau.claudiu95@gmail.com
EMAIL_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
EMAIL_FROM=vladau.claudiu95@gmail.com
EMAIL_FROM_NAME=ESCRO Platform

# --- URLs (must match your domain + scheme) ---
FRONTEND_URL=https://REPLACE_WITH_YOUR_DOMAIN
SERVER_URL=https://REPLACE_WITH_YOUR_DOMAIN

# --- Admin ---
ADMIN_EMAIL=vladau.claudiu95@gmail.com

# --- Optional: Sentry error tracking ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Optional: log level (info | debug | warn | error) ---
LOG_LEVEL=info
